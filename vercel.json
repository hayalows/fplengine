{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python -m pip install -e \".[postgres]\"",
  "regions": ["sfo1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,research/**,.data/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?tab=home" },
    { "source": "/site", "destination": "/api/index?tab=home" },
    { "source": "/site/:tab", "destination": "/api/index?tab=:tab" }
  ]
}
